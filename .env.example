# Anthropic. Used when a step's provider is anthropic and that step has no key of its own.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# OpenAI-compatible APIs (OpenAI, OpenRouter, Groq, Ollama, vLLM).
# Provider `openai` plus a base URL is the portable path. Official OpenAI leaves the URL blank.
OPENAI_API_KEY=
LLM_PROVIDER=anthropic
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=

# Optional per-step overrides. Blank means "use the LLM_* default, then Anthropic".
# MODEL may be `provider:name` (openai:llama3.1) or a bare model name.
# Steps: analyze, resume, cover, format, critique.
# ANALYZE_PROVIDER=
# ANALYZE_MODEL=
# ANALYZE_API_KEY=
# ANALYZE_BASE_URL=
# RESUME_PROVIDER=
# RESUME_MODEL=
# RESUME_API_KEY=
# RESUME_BASE_URL=
# COVER_PROVIDER=
# COVER_MODEL=
# COVER_API_KEY=
# COVER_BASE_URL=
# FORMAT_PROVIDER=
# FORMAT_MODEL=
# FORMAT_API_KEY=
# FORMAT_BASE_URL=
# CRITIQUE_PROVIDER=openai
# CRITIQUE_MODEL=llama3.1
# CRITIQUE_BASE_URL=http://localhost:11434/v1

# Job queue. google (Sheet) or local (jobs.xlsx with the same columns).
JOB_QUEUE=google
GOOGLE_SHEET_ID=
# LOCAL_JOBS_PATH=jobs.xlsx

# Drive folders (full URL or folder ID). Used when DOCUMENT_STORE=google.
GOOGLE_SEED_FOLDER_ID=
GOOGLE_OUTPUT_FOLDER_ID=

# Document location. google (Drive) or local (two folders on disk).
DOCUMENT_STORE=google
LOCAL_SEED_DIR=
LOCAL_OUTPUT_DIR=

# OAuth desktop client downloaded from Google Cloud Console
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=token.json
